{
  "name": "@omicronenergy/oscd-editor-ied",
  "version": "0.0.0",
  "description": "OpenSCD Editor Plugin for Editing the IEDs in an IEC 61850 document.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-editor-ied.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-editor-ied/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec81650"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/oscd-editor-ied.js",
    "./oscd-editor-ied.js": "./dist/oscd-editor-ied.js"
  },
  "files": [
    "/dist/",
    "!/dist/*.spec.*",
    "!/dist/*.test.*"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "deploy": "npm run build && gh-pages -d dist -b deploy",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@omicronenergy/oscd-editor-source": "^0.0.3",
    "@omicronenergy/oscd-menu-open": "^0.0.6",
    "@omicronenergy/oscd-menu-save": "^0.0.2",
    "@omicronenergy/oscd-scl-dialogs": "^0.0.7",
    "@omicronenergy/oscd-shell": "^0.0.10",
    "@omicronenergy/oscd-ui": "^0.0.11",
    "@open-wc/scoped-elements": "^3.0.5",
    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "ace-custom-element": "^1.6.5",
    "lit": "^3.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@lit/localize-tools": "^0.8.1",
    "@playwright/test": "1.54.1",
    "@storybook/web-components": "^8.6.0",
    "@storybook/web-components-vite": "^8.6.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/browser": "^2.1.9",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-wc": "^3.0.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "sinon": "^21.0.1",
    "storybook": "^8.6.0",
    "typescript": "^5.9.3",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@web/test-runner-playwright": {
      "playwright": "1.54.1"
    }
  },
  "customElements": "custom-elements.json",
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  }
}
